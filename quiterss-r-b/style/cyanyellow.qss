/* QuiteRSS-R 青黄 Style — 严格依据 QuiteRSS-R.ini [Color] 配色：青底 #084a5a/#136377 + 亮黄 #fcec0c */

QWidget {
    background-color: #084a5a; /* cpDark — feedsListBackgroundColor */
    alternate-background-color: #084a5a; /* alternatingRowColors */
    color: #e1e0e1; /* cpText — feedsListTextColor */
    selection-background-color: #464546; /* 暗色模式暗灰 — focusedNewsBGColor */
    selection-color: #fcec0c; /* 焦点文字与未读同黄 */ /* focusedNewsTextColor */
}
QWidget:disabled {
	color: #a5a5a5; /* dateColor */
}

QMenuBar {
	background: #063b49;
	color: #e1e0e1;
	padding: 1px;
}

QMenuBar::item {
	padding: 3px 6px;
	background: transparent;
}

QMenuBar::item:selected {
	background: #136377;
	color: #fcec0c;
}

#feedsView_, #newsCategoriesTree_ {
	background: #084a5a;
	color: #e1e0e1;
}

#feedsView_::item, #newsView_::item, #newsCategoriesTree_::item {
	min-height: 20px;
}
#feedsView_::item:selected, #newsCategoriesTree_::item:selected {
	background-color: #063b49; /* 比订阅源列表背景 #084a5a 略深 */
	color: #fcec0c;
}
#newsView_::item:selected {
	background-color: #464546; /* 暗色模式暗灰 */
	color: #fcec0c;
}


#categoriesLabel_, #newsTextTitle_ {
	color: #fcec0c;
}

#feedsPanel_, #categoriesPanel_, #stackedWidget_ {
	background: #084a5a;
}

QTabWidget::pane {
	border: 1px solid #136377;
}

QTabWidget::tab-bar {
	bottom: -1px;
}

QTabBar::tab, #tabBar_::tab {
	background-color: transparent;
	border: 1px solid #136377;
	border-bottom: none;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
	margin: 0;
	margin-top: 1px;
	margin-right: -1px;
}

QTabBar::tab {
	padding: 4px;
}

#tabBar_::tab {
	padding: 4px 1px 4px 1px;
}

QTabBar::tab:last, #tabBar_::tab:last {
	margin-right: 0px;
}

QTabBar::tab:selected, #tabBar_::tab:selected {
	background: #084a5a;
	color: #fcec0c;
	border-color: #fcec0c;
	border-bottom: none;
	padding-bottom: 5px;
}

QTabBar::tab:!selected, #tabBar_::tab:!selected {
	background-color: #063b49;
	border-bottom: 1px solid #136377;
}

QTabBar QToolButton {
	border: 1px solid #136377;
	border-radius: 2px;
}

QTabBar QWidget {
	background: none;
}

#tabBarWidget {
	border-bottom: 1px solid #136377;
}

QToolBar {
	border-style: none;
}

#buttonColumnView {
	border: 1px solid #136377;
	border-radius: 0px;
	border-top: none;
	border-bottom: none;
	margin-bottom: 1px;
	padding: 5px 0px 2px 0px;
	background-color: #063b49;
	min-width: 10px;
}

#progressBar_, #splashProgress {
	border: 1px solid #fcec0c;
	border-radius: 2px;
	background: #084a5a;
}

#progressBar_::chunk, #splashProgress::chunk {
	background: #fcec0c;
	width: 1px;
}

QHeaderView {
	background-color: #063b49;
	color: #e1e0e1;
}

QHeaderView::section {
	border-right: 1px solid #136377;
	border-bottom: 1px solid #136377;
	border-top: none;
	border-left: none;
	background-color: transparent;
	/*padding: 2px;*/
	padding-left: 3px;
}

QHeaderView::down-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorD.png);
}

QHeaderView::up-arrow {
	subcontrol-origin: padding;
	subcontrol-position: center top;
	image: url(:/images/images/sortIndicatorA.png);
}

#webViewProgress_ {
	border: 1px solid #136377;
	border-left: none;
	border-right: none;
	border-bottom: none;
	text-align: center;
	background: #063b49;
	color: #e1e0e1;
}

#webViewProgress_::chunk {
	background: #136377;
	width: 10px;
}

#webViewProgressLabel_ {
	color: #fcec0c;
}

#contentLabel_ {
	background-color: #084a5a;
	color: #e1e0e1;
}

#categoriesTree {
	padding: 1px;
}

#categoriesTree::item, #fontTree::item,
#languageFileList_::item, #filtersTree::item,
#shortcutTree::item, #labelsTree_::item,
#colorsTree_::item {
	min-height: 20px;
}

#foldersTree_::item, #feedsTreeFR::item, #feedsTreeNotify_::item {
	min-height: 18px;
}

QStatusBar #progressBar_{
	margin-right: 5px;
}

QMainWindow::separator {
	border: none;
}

#infoWidgetFR, #actionsWidgetFR {
	
}

#notificationWidget {
	border: 1px solid #fcec0c;
	border-radius: 8px;
}

#titleNotification {
	border-bottom: 1px solid #fcec0c;
	border-top-left-radius: 8px;
	border-top-right-radius: 8px;
}

#bottomNotification {
	border-top: 1px solid #136377;
	border-bottom-left-radius: 8px;
	border-bottom-right-radius: 8px;
}

#feedItemNotification {
	border-bottom: 1px solid #136377;
}

QLineEdit {
	border: 1px solid #063b49;
	background-color: #136377;
	border-radius: 2px;
}

QLineEdit:focus {
	border: 1px solid #fcec0c;
	color: #ffffff;
}

#click2flash-frame {
	border: 1px solid #136377;
	background: #063b49;
}

#click2flash-toolbutton {
	background: url(:/images/images/flash.png) no-repeat;
	background-position: center;
	border: none;
}

#click2flash-toolbutton:hover {
	background: url(:/images/images/flashstart.png) no-repeat;
	background-position: center;
	border:none;
}

#pushButtonNull {
	background: #063b49;
	border: none; 
	padding: 0px;
	min-width: 6px;
}

QPushButton {
	border: 1px solid #063b49;
	background-color: #136377;
	padding: 4px;
	border-radius: 2px;
	min-width: 80px;
}

QPushButton:focus {
	border: 1px solid #fcec0c;
	color: #ffffff;
}

QPushButton:hover {
	border: 1px solid #fcec0c;
	color: #ffffff;
}

#ToolButton {
	border: 1px solid #063b49;
	background-color: #136377;
	padding: 2px;
	border-radius: 2px;
}

#ToolButton:hover {
	border: 1px solid #fcec0c;
	color: #ffffff;
}

#ToolButton[popupMode="1"] {
	padding-right: 16px;
}

#ToolButton::menu-button {
    border: none;
    width: 16px;
}

QScrollBar {
  background: none;
  border: none;
  margin: 0px;
  padding: 0px;
}

QScrollBar:vertical {
  width: 10px;
}

QScrollBar:horizontal {
  height: 10px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal{
  background: #063b49;
}

QScrollBar::handle:vertical {
  background: #136377;
  min-height: 20px;
}

QScrollBar::handle:horizontal {
  background: #136377;
  min-width: 20px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
  background: #fcec0c;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0px;
}

QGroupBox {
	border: 1px solid #136377;
	margin-top: 2ex;
}

QGroupBox::title {
	subcontrol-origin: margin;
	left: 5px;
	padding-left: 3px;
	color: #fcec0c;
}

QComboBox {
	border: 1px solid #063b49;
	background-color: #136377;
	border-radius: 2px;
	padding: 2px;
	padding-left: 4px;
	min-width: 2em;
}

QComboBox:on { 
	color: #ffffff;
}

QComboBox:focus {
	border: 1px solid #fcec0c;
}

QComboBox::drop-down {
	border: none;
	subcontrol-origin: padding;
	subcontrol-position: top right;
	width: 15px;
}

QComboBox::down-arrow {
	image: url(:/images/images/bullet_down.png);
}

QComboBox::down-arrow:on {
	top: 1px;
	left: 1px;
}

QSpinBox {
	border: 1px solid #063b49;
	background-color: #136377;
	border-radius: 2px;
	padding: 2px;
	padding-left: 4px;
}

QSpinBox:focus {
	border: 1px solid #fcec0c;
	color: #ffffff;
}
